# Copy to .env and fill in values

# Server
PORT=8080

# Asterisk AMI
AMI_HOST=127.0.0.1
AMI_PORT=5038
AMI_USER=your_ami_user
AMI_PASS=your_ami_pass

# Bitrix24
BITRIX_WEBHOOK_BASE=https://your-portal.bitrix24.com/rest/1/webhook_code
BRIDGE_TOKEN=your_secret_token_for_webhook_authorization

# Bitrix OAuth (for install/handler flow)
BITRIX_PORTAL=https://your-portal.bitrix24.com
BITRIX_CLIENT_ID=local.xxxxx
BITRIX_CLIENT_SECRET=xxxxx

# Public URL for Bitrix webhooks (Cloudflare Tunnel) — no trailing slash
PUBLIC_BASE_URL=https://pbx.zweighing.com

# Call recordings (optional)
# RECORDINGS_DIR=/var/spool/asterisk/monitor
# RECORDING_PUBLIC_BASE=https://pbx.zweighing.com/recordings
